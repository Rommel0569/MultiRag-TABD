# Copy to .env locally. Do not commit .env or paste API keys into chat.
CEPRUNSA_GENERATOR_PROVIDER=ollama
DEEPSEEK_API_KEY=
CEPRUNSA_GENERATOR_MODEL=llama3:8b
CEPRUNSA_GENERATOR_TEMPERATURE=0.1
CEPRUNSA_ROUTER_PROVIDER=ollama
CEPRUNSA_ROUTER_MODEL=llama3:8b
CEPRUNSA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Índice versionado de referencia; los índices experimentales locales no se suben.
CEPRUNSA_INDEX_DIR=data/index
CEPRUNSA_CACHE_DIR=data/cache
CEPRUNSA_CACHE_MODE=semantic

GOOGLE_API_KEY=
CEPRUNSA_GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite

# OCR uses clean local PDF text first; Textract is the default for pages needing OCR.
CEPRUNSA_OCR_ENGINE=textract
# Set to 1 only when authorizing a Textract run that may incur AWS charges.
CEPRUNSA_ENABLE_PAID_TEXTRACT=0
CEPRUNSA_TEXTRACT_REGION=us-east-1
# Optional named AWS profile (see README: Setting up AWS Textract).
# CEPRUNSA_AWS_PROFILE=ceprunsa

# Espacios nuevos: archivos, extracciones, índice y caché aislados por universidad/contexto.
CEPRUNSA_WORKSPACES_DIR=data/workspaces
CEPRUNSA_MAX_PDF_BYTES=52428800
CEPRUNSA_MAX_PDF_PAGES=500
CEPRUNSA_WORKSPACE_CACHE_MODE=semantic
CEPRUNSA_WORKSPACE_CACHE_SHORTLIST=0.80
CEPRUNSA_WORKSPACE_CACHE_VERIFY=0.60
CEPRUNSA_EMBED_BATCH_SIZE=32
CEPRUNSA_LATENCY_AUDIT_RETENTION_DAYS=7
